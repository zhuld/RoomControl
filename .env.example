# 本机开发环境变量：复制为 .env 后按需修改，.env 不会提交到仓库。
Authentication__AdminUser=admin
Authentication__AdminPassword=请替换为至少12位的本地强密码

# 可选：改用 PostgreSQL（默认使用 SQLite 与 appsettings.Development.json 中的连接串）
# Database__Provider=PostgreSQL
# ConnectionStrings__RoomControl=Host=localhost;Database=roomcontrol;Username=roomcontrol;Password=请填写数据库密码
